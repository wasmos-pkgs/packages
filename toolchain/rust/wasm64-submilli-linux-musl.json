{
  "arch": "wasm64",
  "binary-format": "wasm",
  "crt-objects-fallback": "false",
  "crt-static-allows-dylibs": false,
  "crt-static-default": true,
  "crt-static-respected": true,
  "data-layout": "e-m:e-p:64:64-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20",
  "dll-prefix": "",
  "dll-suffix": ".wasm",
  "dynamic-linking": false,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "entry-name": "__main_argc_argv",
  "env": "musl",
  "exe-suffix": "",
  "features": "+bulk-memory,+mutable-globals,+sign-ext,+nontrapping-fptoint,+reference-types,+simd128,+tail-call",
  "generate-arange-section": false,
  "has-thread-local": false,
  "is-like-wasm": true,
  "linker": "wasm64-submilli-linux-musl-clang",
  "linker-flavor": "wasm-lld-cc",
  "linker-is-gnu": false,
  "lld-flavor": "wasm",
  "llvm-args": [
    "-wasm-use-legacy-eh=false"
  ],
  "llvm-target": "wasm64-unknown-unknown",
  "main-needs-argc-argv": true,
  "max-atomic-width": 64,
  "os": "linux",
  "panic-strategy": "abort",
  "relocation-model": "static",
  "singlethread": false,
  "target-family": [
    "unix"
  ],
  "target-pointer-width": 64,
  "tls-model": "local-exec",
  "vendor": "submilli"
}
